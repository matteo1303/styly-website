{
  "expo": {
    "name": "Styly",
    "slug": "styly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/styly-logo.png",
    "scheme": "styly",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/styly-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Styly usa la foto scelta per aggiungere un capo al tuo guardaroba privato.",
          "cameraPermission": "Styly usa la fotocamera per fotografare i capi che vuoi salvare.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090909",
          "image": "./assets/images/styly-logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
